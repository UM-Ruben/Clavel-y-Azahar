# ============================================================================
#  VARIABLES DE ENTORNO  —  copia este archivo a «.env.local» y rellena
# ----------------------------------------------------------------------------
#  1. Crea un proyecto gratuito en https://supabase.com
#  2. En el panel de Supabase: Project Settings → Data API (o «API»)
#     - «Project URL»  -> VITE_SUPABASE_URL
#     - «anon public»  -> VITE_SUPABASE_ANON_KEY
#  3. Pega los valores abajo, guarda el archivo como «.env.local» y reinicia
#     `pnpm dev`.
#  4. En Vercel: Project → Settings → Environment Variables, añade estas dos
#     mismas variables para que la web publicada también se conecte.
#
#  La «anon key» es pública (va al navegador): es seguro. NO pongas aquí la
#  «service_role key» — esa es secreta y no se usa en este proyecto.
# ============================================================================

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

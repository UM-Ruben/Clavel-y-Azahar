{
  "name": "floristeria",
  "version": "1.0.0",
  "description": "Clavel y Azahar - Floristería en Los Ramos, Murcia",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-react-ssg build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config=playwright.production.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "heic-to": "^1.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.0.2",
    "react-router-dom": "7.18.3",
    "vite-react-ssg": "0.9.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "vite-react-ssg@0.9.2": "patches/vite-react-ssg@0.9.2.patch"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react-router-dom": "7.18.3"
      }
    },
    "overrides": {
      "form-data": "4.0.6",
      "nanoid@3": "3.3.18",
      "postcss-selector-parser@6": "6.1.4",
      "browserslist": "4.28.9",
      "baseline-browser-mapping": "2.11.21"
    }
  }
